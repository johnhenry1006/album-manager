{
    "name": "@album-manager/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.14",
        "npm": ">=10"
    },
    "scripts": {
        "dev": "node --watch src/app/server.js",
        "start": "node src/app/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:generate": "prisma generate --config prisma.config.js",
        "db:migrate": "prisma migrate dev --config prisma.config.js",
        "db:deploy": "prisma migrate deploy --config prisma.config.js",
        "db:seed": "prisma db seed --config prisma.config.js",
        "db:studio": "prisma studio --config prisma.config.js",
        "test:database": "DATABASE_TESTS=1 vitest run src/infrastructure/database/schema.test.js",
        "test:storage": "STORAGE_TESTS=1 vitest run src/infrastructure/storage/s3/s3Storage.integration.test.js"
    },
    "imports": {
        "#modules/*": "./src/modules/*",
        "#infrastructure/*": "./src/infrastructure/*",
        "#shared/*": "./src/shared/*",
        "#config/*": "./src/config/*"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1147.0",
        "@aws-sdk/s3-request-presigner": "^3.1147.0",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "dotenv": "^18.0.6",
        "fastify": "^5.12.5",
        "fastify-plugin": "^6.0.0",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "prisma": "^7.10.0",
        "vitest": "^5.0.3"
    }
}
