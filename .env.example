# Generate an ignored .env with: node infrastructure/scripts/setup-local-env.js
# Alternatively copy this file to .env and fill every blank credential locally.
# Docker Compose and the API load the root .env. Existing process variables win in the API.
COMPOSE_PROJECT_NAME=album-manager
NODE_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info
API_SHUTDOWN_TIMEOUT_MS=10000

# Browser-visible configuration must contain public values only.
# No application entry point or public configuration loader exists yet.
PUBLIC_API_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL: host-run backend settings. In Compose use postgres:5432 instead.
# Optional DATABASE_URL overrides POSTGRES_* for Prisma/API only. Percent-encode credentials.
# DATABASE_URL=postgresql://user:password@localhost:5434/album_manager
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=album_manager
POSTGRES_USER=album_manager
POSTGRES_PASSWORD=

# Redis: in Compose use redis:6379 instead.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Generic backend S3 settings; never expose keys in frontend configuration.
STORAGE_DRIVER=s3
# S3_ENDPOINT is for backend operations. A future containerized API must use
# http://s3ninja:9000 here; browser presigning still uses S3_PUBLIC_ENDPOINT.
S3_PORT=9445
S3_ENDPOINT=http://localhost:9445
S3_PUBLIC_ENDPOINT=http://localhost:9445
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=album-manager
S3_FORCE_PATH_STYLE=true

# Emulator-only settings, not part of the future storage provider interface.
# The public-endpoint proxy supplies CORS for FRONTEND_ORIGIN only.
S3_JAVA_XMX=512m

# Direct browser uploads: metadata registration and completion enforce these limits.
UPLOAD_MAX_FILE_SIZE_BYTES=104857600
UPLOAD_MAX_FILES_PER_SESSION=1000
UPLOAD_URL_EXPIRY_SECONDS=900
UPLOAD_SUPPORTED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif,video/mp4,video/webm,video/quicktime

# Media-processing queue producer (Redis host/port/password are configured above).
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=10000
QUEUE_PREFIX=album-manager

# Dedicated media-processing worker parallel jobs (1-32)
QUEUE_WORKER_CONCURRENCY=1

# Gallery lists: maximum page size (1-1000) and thumbnail URL expiry (1-3600 seconds).
MEDIA_LIST_MAX_LIMIT=200
MEDIA_LIST_URL_EXPIRY_SECONDS=900

# Detail display and explicitly requested original GET URLs: 1-3600 seconds each.
MEDIA_DETAIL_URL_EXPIRY_SECONDS=900
MEDIA_ORIGINAL_URL_EXPIRY_SECONDS=900

# Dedicated trash cleanup worker: positive whole days (1-36500); hourly sweep.
TRASH_RETENTION_DAYS=30
