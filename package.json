{
    "name": "album-manager",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/web",
        "apps/api",
        "packages/shared"
    ],
    "engines": {
        "node": ">=22.14",
        "npm": ">=10"
    },
    "scripts": {
        "check": "node infrastructure/scripts/check-foundation.js",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "npm run check && npm run test:tooling && npm run test --workspaces --if-present",
        "test:tooling": "node --test infrastructure/scripts/*.test.js",
        "db:generate": "npm run db:generate --workspace @album-manager/api --",
        "db:migrate": "npm run db:migrate --workspace @album-manager/api --",
        "db:deploy": "npm run db:deploy --workspace @album-manager/api --",
        "db:seed": "npm run db:seed --workspace @album-manager/api --",
        "db:studio": "npm run db:studio --workspace @album-manager/api --"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-n": "^18.4.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "vite": "^8.3.3"
    }
}
